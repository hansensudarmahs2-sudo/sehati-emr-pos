# ============================================================================
# .env PRODUKSI Sehati (Docker, mini PC) — SALIN jadi ../.env di /srv/sehati
# JANGAN commit / rsync .env asli. Rahasia digenerate DI mini PC.
# ============================================================================

# ----- Application -----
APP_NAME="Klinik Sehati"
APP_ENV=production
APP_DEBUG=false                 # WAJIB false (boot-guard menolak true di production)
APP_HOST=0.0.0.0
APP_PORT=8000

# ----- Database (container MySQL) -----
# DB_HOST di-override compose ke "sehati-db"; nilai di sini boleh apa saja.
DB_HOST=sehati-db
DB_PORT=3306
DB_USER=klinik_dev
DB_NAME=db_sehati
# Generate:  python3 -c "import secrets; print(secrets.token_urlsafe(24))"
DB_PASSWORD=<password-user-db>
# Password root MySQL (dipakai container db + healthcheck). Beda dari DB_PASSWORD.
# Generate:  python3 -c "import secrets; print(secrets.token_urlsafe(24))"
DB_ROOT_PASSWORD=<password-root-db>

# ----- JWT -----
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_HOURS=6
# WAJIB >= 32 char (boot-guard). Generate:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=<hasil-generate-min-32-char>

# ----- Cookie / HTTPS -----
# true: akses via HTTPS (Tailscale serve :8443). WAJIB true di produksi remote.
COOKIE_SECURE=true

# ----- Proxy tepercaya (fix P1-3) -----
# App jalan di container; Tailscale serve → host → gateway Docker → container.
# Peer yang dilihat app = gateway Docker (172.x). Sertakan subnet Docker + loopback.
TRUSTED_PROXIES=127.0.0.1,::1,172.16.0.0/12

# ----- No. RM cabang -----
RM_CLINIC_PREFIX=A

# ----- CORS (satu origin; kosong/aman utk PWA satu host) -----
CORS_ALLOWED_ORIGINS=https://joderma-jemur.tail730d69.ts.net:8443

# ----- Logging + Timezone -----
LOG_LEVEL=INFO
LOG_FORMAT=json
TIMEZONE=Asia/Jakarta

# ----- Idle-timeout sesi -----
SESSION_IDLE_MINUTES=60
SESSION_IDLE_WARN_MINUTES=2

# ----- Konektor AI Antropometri (nonaktif default) -----
ANTRO_BASE_URL=
ANTRO_INTAKE_TOKEN=
SEHATI_WRITEBACK_TOKEN=
