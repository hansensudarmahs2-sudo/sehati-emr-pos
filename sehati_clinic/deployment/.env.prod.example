# ============================================================================
# .env PRODUKSI (contoh) — Sehati Clinic. Salin jadi /opt/sehati_clinic/.env
# JANGAN commit .env asli. Isi nilai <...> dengan yang sebenarnya.
# ============================================================================

APP_NAME="Klinik Sehati"
APP_ENV=production
APP_DEBUG=false                 # WAJIB false: boot-guard MENOLAK start bila true di production (DEC-093)
APP_HOST=0.0.0.0
APP_PORT=8000

# ----- Database (MySQL lokal) -----
DB_HOST=localhost
DB_PORT=3306
DB_USER=klinik_prod
DB_PASSWORD=<password-kuat-produksi>
DB_NAME=db_sehati

# ----- JWT -----
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_HOURS=6
# WAJIB ganti (boot-guard tolak default/<32 char di production):
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=<hasil-generate-min-32-char>

# ----- Cookie -----
# LAN HTTP → false. HTTPS/remote nanti → true.
COOKIE_SECURE=false

# ----- No. RM cabang (fallback; utama dari Profil Klinik rm_prefix) -----
RM_CLINIC_PREFIX=A

# ----- CORS (LAN: cukup kosong / IP server) -----
CORS_ALLOWED_ORIGINS=http://localhost:8000

# ----- Logging + Timezone -----
LOG_LEVEL=INFO
LOG_FORMAT=json
TIMEZONE=Asia/Jakarta

# Idle-timeout sesi (menit). 0 = nonaktif. Peringatan N menit sebelum logout.
SESSION_IDLE_MINUTES=60
SESSION_IDLE_WARN_MINUTES=2
