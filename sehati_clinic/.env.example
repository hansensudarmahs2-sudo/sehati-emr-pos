# =============================================================================
# Environment Configuration — TEMPLATE
# =============================================================================
# Copy file ini jadi `.env` lalu isi nilai sebenarnya.
# File `.env` JANGAN di-commit ke Git (sudah di .gitignore).
# =============================================================================

# ----- Application -----
APP_NAME="Klinik Sehati API"
APP_ENV=development              # development | staging | production
APP_DEBUG=true                    # set false di production
APP_HOST=0.0.0.0
APP_PORT=8000

# ----- Database (MySQL) -----
DB_HOST=localhost
DB_PORT=3306
DB_USER=klinik_dev
DB_PASSWORD=Klinik123!
DB_NAME=db_sehati

# ----- JWT (Authentication) -----
# Generate secret kuat dengan:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=GANTI_DENGAN_SECRET_GENERATED__JANGAN_PAKAI_INI_DI_PRODUCTION
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_HOURS=6   # sesuai logika anchor shift dokter

# ----- Web Cookie Security -----
# COOKIE_SECURE=true: browser hanya kirim cookie via HTTPS (WAJIB di production).
# COOKIE_SECURE=false: cookie dikirim via HTTP juga (HANYA untuk dev localhost).
# Default di app/config.py = True (failure-secure).
COOKIE_SECURE=false               # dev localhost; SET true di production HTTPS

# ----- Security headers: CSP + HSTS (S1, ASVS V14.4.1) -----
# Header dasar (nosniff / X-Frame-Options / Referrer-Policy / Permissions-Policy)
# SELALU dikirim dan tidak punya tombol. Dua di bawah ini yang bisa disetel.
#
# CSP — default AKTIF dan MENEGAKKAN. Kebijakan lengkapnya ada di app/config.py
# (security_csp_policy). Ia menutup origin luar, clickjacking (frame-ancestors),
# dan form-hijack (form-action). Aplikasi 100% self-host tanpa CDN, jadi tidak
# ada yang diblokir — diverifikasi 2026-10-04: nol sumber eksternal di template,
# nol pemakaian eval, dan tidak satu pun fitur HTMX yang butuh eval dipakai.
#
# ⚠ Kebijakannya memakai 'unsafe-inline' untuk script-src dan style-src. Itu
#   melemahkan perlindungan XSS-nya. Penyebabnya 89 handler inline (onclick dll)
#   di template — nonce TIDAK bisa menolong untuk itu, perlu refactor ke
#   addEventListener. Lihat Project_Memory/S1_CSP_HSTS.md.
#
# SECURITY_CSP_REPORT_ONLY=true → kirim Content-Security-Policy-Report-Only
# (tidak menegakkan). Pakai saat menguji kebijakan yang lebih ketat.
SECURITY_CSP_ENABLED=true
SECURITY_CSP_REPORT_ONLY=false

# HSTS — default NONAKTIF. Hanya bermakna lewat HTTPS; di LAN HTTP ia diabaikan
# browser. AKTIFKAN DI .env MINI PC (HTTPS lewat Tailscale serve sudah ada).
#
# ⚠ HSTS itu LENGKET. Begitu browser menerimanya, ia menolak HTTP ke host itu
#   selama max-age — walau HTTPS-nya rusak. Kalau Tailscale serve bermasalah,
#   mini PC jadi tak terjangkau dari browser yang terlanjur menyimpannya.
#   Karena itu: MULAI PENDEK (86400 = 1 hari), amati beberapa minggu, baru naik
#   ke 31536000 (1 tahun). Menurunkan max-age butuh waktu menyebar.
#
# SENGAJA TANPA includeSubDomains — jangan paksa HTTPS ke photodex.joderma.id
# yang LAN-nya HTTP.
SECURITY_HSTS_ENABLED=false
SECURITY_HSTS_MAX_AGE=86400

# ----- CORS (untuk frontend nanti) -----
# Comma-separated list. Untuk dev, allow localhost.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000

# ----- Logging -----
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json                   # json | text (text untuk dev, json untuk production)

# ----- Timezone -----
TIMEZONE=Asia/Jakarta

# --- Konektor AI Antropometri (AN-L1) ---
# Kosongkan = konektor NONAKTIF (default aman). Isi saat modul antropometri siap.
# ANTRO_BASE_URL: alamat LAN modul (mis. http://pc-a.local:8051).
# ANTRO_INTAKE_TOKEN (Token A): nilai SAMA dengan .env modul. Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
# SEHATI_WRITEBACK_TOKEN (Token B): Sehati terbitkan; dipakai modul saat write-back (fase berikut).
ANTRO_BASE_URL=
ANTRO_INTAKE_TOKEN=
SEHATI_WRITEBACK_TOKEN=
